# .env.ec2.example — template for deploying ASK to a single remote host on AWS
# EC2. Copy it to .env on your host and fill in the values.
#
# Serve it behind TLS. The variables here do not configure a certificate, so a
# host reached over plain HTTP leaves traffic — session tokens included — in the
# clear, and the browser withholds crypto.subtle, which PKCE needs.
#
# There is NO separate remote compose overlay: a remote deploy runs the SAME
# docker-compose.yml as local, only the .env values differ. Mirrors
# .env.example section-for-section, with EXTERNAL_HOST + the
# Confluent-coexistence port remaps pre-filled. On your host:
#
#   cp .env.ec2.example .env
#   # edit the values below, then rebuild the SPAs (VITE_* are baked at BUILD
#   # time, so they MUST be rebuilt whenever EXTERNAL_HOST changes) and start:
#   docker compose build ask-studio-spa ask-chat-spa ask-setup-spa
#   docker compose up -d
#
#
# ─────────────────────────────────────────────────────────────────────────────
# WHAT LIVES HERE vs WHAT LIVES IN ASK SETUP
#
# This file carries ONLY bootstrap + deploy config: the OpenSearch connection,
# the encryption master key, auth posture, host/ports, and opt-in integrations
# (SAP S/4HANA, Teams).
#
# It does NOT own your LLM, embedder, or DATABASE credentials. Those are
# configured in the ASK Setup UI and stored ENCRYPTED in OpenSearch (editable at
# runtime — no restart, no file edit), which OVERRIDES anything here. The
# provider vars near the bottom are an OPTIONAL pre-UI bootstrap; leave empty.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Browser-facing host (REQUIRED on EC2) ───────────────────────────────────
# The PUBLIC DNS or IP the BROWSER uses. No scheme, no port — just the host.
# Baked into the SPA bundles at BUILD time + Keycloak's issuer URL — REBUILD the
# SPAs after changing it. Internal service-to-service calls stay on the Docker
# network and are unaffected.
#   e.g.  ec2-XX-XX-XX-XX.us-east-2.compute.amazonaws.com   or   the public IP
EXTERNAL_HOST=

# ─── Auth posture ────────────────────────────────────────────────────────────
# AUTH_MODE: keycloak (default) | xsuaa (SAP BTP Cloud Identity) | none (dev).
# DEV_BYPASS_AUTH honored ONLY when ENVIRONMENT=local (both flags must align).
ENVIRONMENT=local
AUTH_MODE=keycloak
DEV_BYPASS_AUTH=true
# The chat SPA runs dev-auth on this plain-HTTP box: PKCE's crypto.subtle needs a
# secure context (HTTPS or localhost) that http://<public-ip> can't provide. The
# admin + setup SPAs still do PKCE and need the Chrome insecure-origin flag (see
# runbook §7). DEV_BYPASS_AUTH=true so the chat SPA's dev-mode calls aren't 401'd.
CHAT_AUTH_MODE=dev

# ─── Compose project name (volume + network prefix) ──────────────────────────
# Leave unset for a single deployment: compose derives it from the directory name.
#
# Set it when you run a CANDIDATE version alongside the retired one on the same
# box (runbook §11). It is what prefixes the named volumes — `<project>_opensearch
# -data` / `<project>_keycloak-data` — so a distinct value is the ONLY thing that
# keeps the candidate from opening the old data. The `container_name:` values in
# docker-compose.yml are fixed, so the two stacks must not run at the same time:
# bring the old one down (WITHOUT `-v`) first.
# COMPOSE_PROJECT_NAME=ask-v2

# ─── Host port remaps (host side only) ───────────────────────────────────────
# Container ports never change; the SPAs reach the backends by container name, so
# these only matter for external/M2M callers + health probes. Pre-set to dodge a
# co-located Confluent stack (Kafka Connect 8083, Schema Registry 8081).
ORCH_HOST_PORT=8085
ADMIN_API_HOST_PORT=8091
TEAM_BOT_HOST_PORT=8086
MCP_HOST_PORT=4004

# ─── Encrypted-secrets master key (REQUIRED — backends abort at boot without it)
# Fernet key = 32-byte urlsafe-base64. Generate one (stdlib, no extra deps):
#   python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep it STABLE across redeploys — it decrypts the provider secrets stored in
# OpenSearch; changing it later makes previously-stored secrets undecryptable.
ONIBEX_ENCRYPTION_KEY=

# ─── OpenSearch (bootstrap store — env-first) ────────────────────────────────
# OpenSearch holds the encrypted secret store, so its OWN connection can't live
# inside it — it lives here. Inside the compose network the cluster is the
# ``opensearch`` service. Shown read-only in ASK Setup › Infrastructure.
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
# Optional — must match the active embedder's output dimension.
# OPENSEARCH_EMBEDDING_DIM=1024

# ─── Semantic-layer repo (bind-mounted into ask-admin-api) ───────────────────
# Absolute path ON THE REMOTE HOST to the semantic-layer git repo. MUST be a real
# git repo — if you start from scratch, `git init` it first (publish-to-env
# needs a real repo).
SEMANTIC_LAYER_HOST_PATH=/opt/ask/semantic-layer

# ─── Keycloak admin console (http://<EXTERNAL_HOST>:8180/admin) ──────────────
# Compose defaults these to admin/admin; CHANGE them on this shared box.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-admin

# ─── Machine-to-machine ingest API key (POST /v1/ingest/*) ───────────────────
# Generate with: openssl rand -hex 32
ASK_INGEST_API_KEY=change-me-ingest-key

# ─── SQL backend drivers (baked into the images at BUILD time) ───────────────
# Must match between ask-orchestrator and ask-admin-api. Add sqlserver/db2 only
# if the images carry the system ODBC/CLI libs. NOTE: the actual DB CONNECTIONS
# are configured in ASK Setup › Database (encrypted in OpenSearch), not here.
EXECUTOR_EXTRAS=[snowflake,databricks,clickhouse,bigquery]

# ─── OPTIONAL: pre-UI LLM provider bootstrap — NORMALLY LEAVE EMPTY ──────────
# The live LLM + embedder are configured in ASK Setup › LLM Providers (encrypted
# in OpenSearch), which OVERRIDES anything here at runtime. Populate only to
# bootstrap a provider before the UI is reachable.
# AWS Bedrock (via LiteLLM) — the default backend. On an AWS instance, prefer
# an IAM role with `bedrock:InvokeModel` (+ titan-embed): boto3 picks it up
# automatically — leave these empty. Only set them if you can't use a role:
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-2
# SAP AI Core (legacy managed provider; creds also load from
# config/aicore_config.json, which takes precedence over these):
# AICORE_AUTH_URL=
# AICORE_CLIENT_ID=
# AICORE_CLIENT_SECRET=
# AICORE_BASE_URL=
# AICORE_RESOURCE_GROUP=default

# ─── OPTIONAL: SAP S/4HANA (only the opt-in MCP server reads these) ──────────
# SAP_S4_SALESORDER_BASE_URL=https://<SAP_IP>:44300
# SAP_S4_SALESORDER_URL=https://<SAP_IP>:44300
# SAP_S4_SALESORDER_USERNAME=
# SAP_S4_SALESORDER_PASSWORD=
# NODE_TLS_REJECT_UNAUTHORIZED=0
# PORT=4004

# ─── OPTIONAL: Teams bot (only the opt-in teams-bot service reads these) ─────
# A registered Teams channel needs an HTTPS endpoint reachable from Microsoft's
# cloud — plain HTTP :8086 only works with the Bot Framework Emulator.
# BOT_APP_ID=
# BOT_APP_PASSWORD=
