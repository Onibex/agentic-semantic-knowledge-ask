# .env.example — LOCAL template. Copy to .env and fill in.
#
#   cp .env.example .env
#   # edit the values below, then:
#   docker compose up -d --build
#
# Secrets below are intentionally blank. NEVER commit a real .env.
# For a remote / EC2 box start from .env.ec2.example instead (same vars, with
# EXTERNAL_HOST + port remaps pre-filled). There is NO EC2 compose overlay —
# both use this same docker-compose.yml, only the .env values differ.
#
# ─────────────────────────────────────────────────────────────────────────────
# WHAT LIVES HERE vs WHAT LIVES IN ASK SETUP
#
# This file carries ONLY bootstrap + deploy config: the OpenSearch connection,
# the encryption master key, auth posture, host/ports, and opt-in integrations
# (SAP S/4HANA, Teams).
#
# It does NOT own your LLM, embedder, or DATABASE credentials. Those are
# configured in the ASK Setup UI and stored ENCRYPTED in OpenSearch (editable at
# runtime — no restart, no file edit), which OVERRIDES anything here. The
# provider vars near the bottom are an OPTIONAL pre-UI bootstrap; leave empty.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Browser-facing host (single knob for local AND remote/EC2) ──────────────
# The host the BROWSER uses to reach Keycloak + the 3 SPAs. Baked into the SPA
# bundles at BUILD time and into Keycloak's issuer URL — REBUILD the SPAs after
# changing it. Local: leave as localhost. Remote/EC2: set to the public DNS/IP.
EXTERNAL_HOST=localhost

# ─── Auth posture ────────────────────────────────────────────────────────────
# AUTH_MODE: keycloak (default) | xsuaa (SAP BTP Cloud Identity) | none (dev).
# DEV_BYPASS_AUTH honored ONLY when ENVIRONMENT=local (both flags must align).
ENVIRONMENT=local
AUTH_MODE=keycloak
DEV_BYPASS_AUTH=false
# CHAT_AUTH_MODE overrides the chat SPA's auth INDEPENDENTLY of AUTH_MODE (unset =
# follows AUTH_MODE). Set `dev` on a plain-HTTP box (PKCE's crypto.subtle needs a
# secure context that http://<ip> can't provide; localhost is exempt).
# CHAT_AUTH_MODE=

# ─── Host port remaps (host side only) ───────────────────────────────────────
# Container ports never change; the SPAs reach the backends by container name, so
# these only matter for external/M2M callers + health probes. Uncomment to dodge
# a co-located Confluent stack (Kafka Connect 8083, Schema Registry 8081).
# ORCH_HOST_PORT=8085
# ADMIN_API_HOST_PORT=8091
# TEAM_BOT_HOST_PORT=8086
# MCP_HOST_PORT=4004

# ─── Encrypted-secrets master key (REQUIRED — backends abort at boot without it)
# Fernet key = 32-byte urlsafe-base64. Generate one:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep it STABLE — it decrypts the provider secrets stored in OpenSearch.
ONIBEX_ENCRYPTION_KEY=

# ─── OpenSearch (bootstrap store — env-first) ────────────────────────────────
# OpenSearch holds the encrypted secret store, so its OWN connection can't live
# inside it — it lives here (the bootstrap chicken-and-egg). Shown read-only in
# ASK Setup › Infrastructure; this file is the single source of truth.
#   - docker-compose: host = the ``opensearch`` service (default below).
#   - host-run dev:   set OPENSEARCH_HOST=localhost.
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
# Optional — must match the active embedder's output dimension.
# OPENSEARCH_EMBEDDING_DIM=1024

# ─── Semantic-layer repo (bind-mounted into ask-admin-api) ───────────────────
# Absolute path to the semantic-layer git repo. MUST be a real git repo.
SEMANTIC_LAYER_HOST_PATH=

# ─── Keycloak admin console (http://localhost:8180/admin) ────────────────────
# Compose defaults these to admin/admin; change them on any shared box.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# ─── Machine-to-machine ingest API key (POST /v1/ingest/*) ───────────────────
# Generate with: openssl rand -hex 32
ASK_INGEST_API_KEY=

# ─── Curated column naming (technical | alias) ───────────────────────────────
# How ingestion mints physical column names from the extractor JSON:
#   technical (default) -> <fldname>_<tabname>        e.g. vbeln_vbak
#   alias               -> <alias_fldname>_<tabname>  e.g. documento_ventas_vbak
# Fix BEFORE the first ingest; never change on a populated deployment.
# See _internal/docs/ImplementationPlan/REQ_CURATED_COLUMN_NAMING.md
# ASK_COLUMN_NAMING=technical

# ─── Semantic-layer authoring language: en | es (default en) ──────────────────
# The language the layer's FREE TEXT is authored in — descriptions, synonyms,
# entity aliases — AND the language the retrieval query is expressed in. Both
# must agree: a Spanish corpus searched with English terms matches nothing
# lexically and degrades the vector leg, silently.
# Does NOT affect: physical column names / ids, the closed English enums
# (business_process, field_role, …), or the chat answer, which always mirrors the
# USER's question. Requires a multilingual embedder for a non-English layer.
# FIX IT BEFORE POPULATING THE CORPUS. The authoring prompts read this per call,
# but the OpenSearch text analyzer is baked in when each index is CREATED and
# cannot be changed in place — so flipping this later leaves the index analyzing
# in the OLD language until you drop the indices and re-publish (dev first).
# See _internal/docs/ImplementationPlan/PLAN_SEMANTIC_LANGUAGE.md
# ASK_SEMANTIC_LANGUAGE=en

# ─── Orchestrator URL used by admin-api for cache invalidation ───────────────
# On an LLM/DB config change, admin-api POSTs {ASK_ORCHESTRATOR_URL}/v1/internal/
# reload so the orchestrator rebuilds its singletons immediately. Compose already
# defaults this to the CONTAINER name (http://ask-orchestrator:8080) — only set
# it here if the orchestrator lives outside the compose network. Leaving it wrong
# is not fatal: the orchestrator also self-heals within 60 s via the LLM config
# fingerprint (factory.llm_revision).
# ASK_ORCHESTRATOR_URL=http://ask-orchestrator:8080

# ─── SQL backend drivers (baked into the images at BUILD time) ───────────────
# Must match between ask-orchestrator and ask-admin-api. Add sqlserver/db2 only
# if the images carry the system ODBC/CLI libs. NOTE: the actual DB CONNECTIONS
# are configured in ASK Setup › Database (encrypted in OpenSearch), not here —
# this only controls which driver libraries ship in the image.
EXECUTOR_EXTRAS=[snowflake,databricks,clickhouse,bigquery]

# ─── OPTIONAL: pre-UI LLM provider bootstrap — NORMALLY LEAVE EMPTY ──────────
# The live LLM + embedder are configured in ASK Setup › LLM Providers (encrypted
# in OpenSearch), which OVERRIDES anything here at runtime. Populate only to
# bootstrap a provider before the UI is reachable.
# AWS Bedrock (via LiteLLM) — the default backend:
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-1
# SAP AI Core (legacy managed provider; creds also load from
# config/aicore_config.json, which takes precedence over these):
# AICORE_AUTH_URL=
# AICORE_CLIENT_ID=
# AICORE_CLIENT_SECRET=
# AICORE_BASE_URL=
# AICORE_RESOURCE_GROUP=default

# ─── OPTIONAL: SAP S/4HANA (only the opt-in MCP server reads these) ──────────
# SAP_S4_SALESORDER_BASE_URL=
# SAP_S4_SALESORDER_URL=
# SAP_S4_SALESORDER_USERNAME=
# SAP_S4_SALESORDER_PASSWORD=
# NODE_TLS_REJECT_UNAUTHORIZED=0
# PORT=4004

# ─── OPTIONAL: Teams bot (only the opt-in teams-bot service reads these) ─────
# BOT_APP_ID=
# BOT_APP_PASSWORD=

# Compose project name (services use explicit container names; this just groups
# the stack's default network/volumes).
COMPOSE_PROJECT_NAME=agentic-semantic-knowledge
