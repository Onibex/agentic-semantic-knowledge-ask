# SAP S/4HANA connection — copy to .env and fill in your values
SAP_S4_SALESORDER_BASE_URL=https://<IP>:44300
SAP_S4_SALESORDER_URL=https://<IP>:44300
SAP_S4_SALESORDER_USERNAME=<usuario>
SAP_S4_SALESORDER_PASSWORD=<password>

# MCP server port
PORT=4004

# Disable TLS verification for self-signed SAP CAL certificates
NODE_TLS_REJECT_UNAUTHORIZED=0
