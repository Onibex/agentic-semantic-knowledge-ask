FROM node:20-alpine

WORKDIR /app

# Install dependencies and apply Basic Auth patch (via postinstall).
# npm ci, not npm install: it installs exactly what the lockfile pins, so the
# image matches the tree that was audited instead of resolving fresh at build.
COPY services/ask-mcp-server/package.json services/ask-mcp-server/package-lock.json ./
COPY services/ask-mcp-server/patch.js .
RUN npm ci

# No api-config.json is baked in any more. It is fetched from the admin API at
# boot by the script below, which is what removed the last shared writable file
# in the platform. A baked copy kept "as a fallback" would reintroduce exactly
# the defect being removed: two sources of truth, one silently shadowing the
# other.
COPY services/ask-mcp-server/fetch-contracts.js .

# Startup script: fetches the contracts, then starts the proxy
COPY services/ask-mcp-server/start.sh .
RUN sed -i 's/\r//' start.sh && chmod +x start.sh

ENV NODE_TLS_REJECT_UNAUTHORIZED=0
ENV PORT=4004

EXPOSE 4004

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD wget -qO- http://localhost:4004/health || exit 1

CMD ["sh", "/app/start.sh"]
